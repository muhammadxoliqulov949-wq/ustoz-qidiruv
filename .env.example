# ---------------------------------------------------------------------------
# USTOZ — environment template (Phase 11)
#
# Copy to `.env.local` and adjust. NEVER commit a filled-in .env file: only
# this template is tracked. No real secret belongs in this file.
#
# Two tiers:
#   NEXT_PUBLIC_*  → inlined into the CLIENT bundle. Public by definition.
#   everything else → SERVER ONLY, validated in src/server/env.ts, which
#                     imports "server-only" so importing it from a Client
#                     Component is a build error.
# ---------------------------------------------------------------------------

# --------------------------- public (client-safe) ---------------------------
NEXT_PUBLIC_APP_NAME=USTOZ
NEXT_PUBLIC_API_BASE_URL=

# ------------------------------ database ------------------------------------
# pglite → embedded PostgreSQL (wasm). DEVELOPMENT/TEST ONLY: it stores the
#          cluster in a local directory and cannot serve a real deployment,
#          where the filesystem is ephemeral and often read-only.
# pg     → a real PostgreSQL server. REQUIRED in production.
#
# PRODUCTION: DB_DRIVER=pg AND DATABASE_URL are both required. The runtime
# refuses to open a database in production with any other driver and raises an
# explicit configuration error naming these variables — it never silently
# falls back to PGlite, and never touches `.data/pglite`.
DB_DRIVER=pglite

# Only read when DB_DRIVER=pg. Use a POOLED connection string, e.g.
# postgresql://user:password@host/db?sslmode=verify-full (Neon pooler, Supabase
# pgbouncer, Vercel Postgres pooled). Real credentials: never commit a value.
# A legacy ?sslmode=require value still connects: the pool normalizes it to
# the explicitly-verifying verify-full (Phase 22).
# DATABASE_URL=postgresql://user:password@localhost:5432/ustoz

# Where the embedded database keeps its files (DB_DRIVER=pglite only; unused in
# production, where the PGlite driver is refused outright).
PGLITE_DATA_DIR=.data/pglite

# -------------------------------- auth --------------------------------------
# Set to 1 ONLY for local http testing: it drops the `Secure` cookie flag.
# Production must leave this unset/0 — session cookies are HttpOnly + Secure
# + SameSite=Lax and hold an opaque token whose hash is stored server-side.
AUTH_INSECURE_COOKIES=0

# ------------------------------- auth upgrade (Phase 23.5) -------------------
# Google OAuth 2.0 / OpenID Connect credentials.
# Public students and teachers can sign in with Google.
# Google stable account id (`sub`) is used as provider identity.
# Never commit real credentials.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Optional callback override. Defaults to ${APP_BASE_URL}/api/auth/google/callback
# GOOGLE_REDIRECT_URI=
# Server-only HMAC secret (min 32 chars) for cryptographic integrity protection of
# OAuth state cookies (ustoz_oauth_state). Required outside test mode whenever Google OAuth is enabled.
# AUTH_OAUTH_STATE_SECRET=

# Transactional email for email verification.
# In development/testing, DevEmailProvider is used when RESEND_API_KEY is unset,
# logging verification URLs with zero external network dependency.
# In production, RESEND_API_KEY is required for public email delivery.
# RESEND_API_KEY=
# Sender email address. Must use a verified domain owned by us before public delivery.
# In dev/test mode with Resend, onboarding@resend.dev can be used.
AUTH_EMAIL_FROM=onboarding@resend.dev

# The ONLY source of the password for a newly created admin/operator account,
# read by `npm run admin:create` (phone identity) and `npm run admin:create-email`
# (email identity). Rules enforced by scripts/admin.ts:
#   - required: without it both commands refuse and create nothing;
#   - minimum 12 characters (the marketplace minimum is 8, operators get more);
#   - never interactive, never echoed, never stored — only its argon2id hash is
#     written to `users.password_hash`, and only `admin*` output is masked.
# It is a per-invocation value, not a shared secret: set it inline for the one
# command that needs it and do not leave it in the environment afterwards.
# There is no default and no seeded admin anywhere in the codebase.
# ADMIN_PASSWORD=

# -------------------------------- dev tools ----------------------------------
# Password given to every seeded demo account. Dev only; if unset the seed
# generates a random one and prints it once. Never set in production.
# DEV_SEED_PASSWORD=

# Re-enables the Phase 9 teacher "workspace picker" as a read-only catalogue
# demo. It is NOT authentication and grants no access. Forced off in
# production regardless of this value.
DEMO_TEACHER_WORKSPACE=0

# ------------------------------- payments (Phase 14) -------------------------
# Payment provider: Payme Business (Merchant API). Everything below is
# SERVER-ONLY. None of these names start with NEXT_PUBLIC_, so none of them can
# ever reach the client bundle — that is enforced by Next.js, not by convention.
#
# PAYMENT_MODE controls the whole subsystem:
#   disabled   → no payment can be initiated at all (safe default; the student
#                UI says so plainly instead of offering a dead button).
#   test       → Payme sandbox cabinet. Use the TEST cashbox key.
#   production → real money. Refused unless NODE_ENV=production.
#
# When PAYMENT_MODE is not "disabled", startup FAILS if the merchant id or key
# is missing. Failing to boot is the correct outcome: a half-configured payment
# system must never run.
PAYMENT_MODE=disabled

# Cashbox (kassa) identifier from the Payme merchant cabinet.
# PAYME_MERCHANT_ID=

# The cashbox KEY — this is the Basic-auth password Payme signs its callbacks
# with (36 characters). It is the single most sensitive value in this file.
# Never commit it, never log it, never send it to the browser. Use the TEST key
# while PAYMENT_MODE=test and the PRODUCTION key only in production.
# PAYME_MERCHANT_KEY=

# Basic-auth LOGIN Payme uses when calling our callback. Payme's technical
# specialist assigns it; it is "Paycom" for standard integrations.
PAYME_MERCHANT_LOGIN=Paycom

# Checkout host the student is redirected to.
#   production → https://checkout.paycom.uz
#   sandbox    → https://test.paycom.uz
PAYME_CHECKOUT_URL=https://checkout.paycom.uz

# Absolute origin of THIS app, used to build the post-payment return URL
# server-side. The return URL is never accepted from the browser, so this must
# be set for a real deployment, e.g. https://ustoz.uz
# APP_BASE_URL=http://localhost:3000

# ------------------------------- storage (Phase 18 & 21) ---------------------
# Storage provider for avatars, course covers and verification evidence.
# SERVER-ONLY. None of these names start with NEXT_PUBLIC_, so none of them can
# reach the client bundle.
#
# STORAGE_PROVIDER controls media storage:
#   disabled   → no uploads, honest UI copy (safe default when unconfigured).
#   local      → DEVELOPMENT ONLY (.data/storage). Refused in production.
#   s3         → S3-compatible object storage (Cloudflare R2, AWS S3, MinIO).
STORAGE_PROVIDER=disabled

# Local filesystem root (STORAGE_PROVIDER=local only; ignored in production).
STORAGE_LOCAL_DIR=.data/storage

# HMAC secret for local signed private reads (STORAGE_PROVIDER=local dev only).
# STORAGE_SIGNING_SECRET=dev-local-storage-signing-secret

# PRIVATE BUCKET — strictly for teacher verification documents.
# In production, this bucket must have NO public domain, NO public access,
# and NO bucket website enabled. Objects are only accessible via signed URLs
# generated server-side for authorized viewers (admin review or owner teacher).
# STORAGE_S3_BUCKET=ustoz-private

# PUBLIC BUCKET — for teacher profile images and course covers.
# In production (NODE_ENV=production), this is REQUIRED and must be distinct
# from STORAGE_S3_BUCKET. Fronted by STORAGE_PUBLIC_BASE_URL.
# STORAGE_S3_PUBLIC_BUCKET=ustoz-public

# S3 Region. Cloudflare R2 requires "auto". AWS S3 uses standard regions (e.g. eu-central-1).
# STORAGE_S3_REGION=auto

# Custom S3 endpoint for Cloudflare R2, MinIO, or custom S3-compatible services.
# Cloudflare R2 format: https://<cloudflare_account_id>.r2.cloudflarestorage.com
# Omit for standard AWS S3.
# STORAGE_S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com

# S3 API credentials. Use least-privilege tokens scoped to the required buckets.
# Never commit real credentials.
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=

# Path-style addressing flag ("0" or "1").
# "0" (default) for AWS S3 and Cloudflare R2.
# "1" for MinIO or S3 gateways requiring path-style URLs.
STORAGE_S3_FORCE_PATH_STYLE=0

# Public base URL where PUBLIC bucket objects are fetched by browsers and CDN.
# REQUIRED when STORAGE_PROVIDER=s3.
# Points ONLY to the public bucket or its custom domain / CDN.
# Must NOT expose the private bucket.
# STORAGE_PUBLIC_BASE_URL=https://media.ustoz.uz

